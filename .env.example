# Build-time default for the backend URL. Used as a pre-fill on the first-launch
# setup screen and as a fallback when no value is saved in localStorage. Once
# the user saves a backend URL via the in-app Settings dialog, that stored
# value takes precedence and this env var is ignored at runtime. For static
# distributions (e.g. GitHub Pages) leave this unset so every user is prompted.
VITE_API_BASE_URL=http://localhost:8080
# Set to "false" to bypass the in-browser MSW mocks and hit the real backend at VITE_API_BASE_URL.
VITE_USE_MOCKS=true
